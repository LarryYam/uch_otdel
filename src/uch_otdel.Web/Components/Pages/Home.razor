@page "/"
@inherits ShellPage
@inject IConfiguration Configuration

<PageTitle>Учебный отдел</PageTitle>

<section class="welcome">
    <h1>Добро пожаловать в «Учебный отдел»</h1>
    <p class="welcome-lead">
        @(Configuration["Organization:Name"] ?? "Название организации") · учебный год <b>@Shell.Year</b>
    </p>
    <p class="subtle">
        Расчёт и распределение учебной нагрузки: учебные планы и группы, правила расчёта, нагрузка
        преподавателей по договорам.
    </p>

    <div class="welcome-steps">
        @foreach (var section in AppMenu.Sections)
        {
            var first = section.Entries[0];
            <a class="welcome-step" href="@first.Path">
                <span class="welcome-step-title">@section.Title</span>
                <span class="subtle small">@string.Join(" · ", section.Entries.Select(e => e.Text))</span>
            </a>
        }
    </div>

    <p class="subtle small">
        Меню разделов — кнопка <RadzenIcon Icon="menu" class="welcome-inline-icon" /> слева вверху.
        Справка, журнал и администрирование — в меню <RadzenIcon Icon="more_vert" class="welcome-inline-icon" /> справа.
        Сообщения и предупреждения появляются в нижней панели — кнопка <RadzenIcon Icon="notes" class="welcome-inline-icon" />.
    </p>
</section>

@code {
    protected override string ScreenTitle => "Главная";
}
