@inherits LayoutComponentBase

<RadzenComponents />

<header class="app-header">
    <div class="app-brand">
        <RadzenIcon Icon="school" />
        <span>Учебный отдел</span>
    </div>
    <nav class="app-nav">
        <NavLink href="" Match="NavLinkMatch.All">Загрузка преподавателей</NavLink>
    </nav>
